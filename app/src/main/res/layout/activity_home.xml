<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_sheet"
    tools:context=".HomeActivity">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="0dp"
        android:layout_height="210dp"
        android:background="@drawable/bg_home_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvWelcomeSanctuary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:text="@string/welcome_sanctuary"
        android:textColor="@color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btnNotifications"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/title_on_sage"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="@id/tvWelcomeSanctuary"
        app:layout_constraintStart_toStartOf="@id/tvWelcomeSanctuary"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeSanctuary"
        tools:text="Tiyah Singh" />

    <ImageButton
        android:id="@+id/btnNotifications"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/notifications"
        android:src="@drawable/ic_bell"
        app:layout_constraintBottom_toBottomOf="@id/tvUserName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvWelcomeSanctuary" />

    <ImageView
        android:id="@+id/ivLogoBadge"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="@string/logo_badge_description"
        android:scaleType="fitCenter"
        android:src="@drawable/img_logo_badge"
        app:layout_constraintBottom_toBottomOf="@id/headerBackground"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerBackground" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/balanceCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_balance_card"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogoBadge">

        <TextView
            android:id="@+id/tvTotalBalanceLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/total_balance"
            android:textColor="@color/hint_text"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/balanceDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalBalance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/green_dark"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tvTotalBalanceLabel"
            app:layout_constraintStart_toStartOf="@id/tvTotalBalanceLabel"
            app:layout_constraintTop_toBottomOf="@id/tvTotalBalanceLabel"
            tools:text="R7,783.00" />

        <View
            android:id="@+id/balanceDivider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:background="@color/sage_header"
            app:layout_constraintBottom_toBottomOf="@id/tvTotalExpense"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTotalBalanceLabel" />

        <TextView
            android:id="@+id/tvTotalExpenseLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/total_expense"
            android:textColor="@color/hint_text"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/balanceDivider"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalExpense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/expense_accent"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/tvTotalExpenseLabel"
            app:layout_constraintStart_toStartOf="@id/tvTotalExpenseLabel"
            app:layout_constraintTop_toBottomOf="@id/tvTotalExpenseLabel"
            tools:text="-R1,187.40" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TODO: Restore the sapling / watering-can growth status from the Figma home screen. -->
    <FrameLayout
        android:id="@+id/placeholderSapling"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/balanceCard" />

    <!-- TODO: Restore the savings progress bar and goal amount from the Figma home screen. -->
    <FrameLayout
        android:id="@+id/placeholderGoalProgress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeholderSapling" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/periodToggle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:checkedButton="@id/btnMonthly"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/placeholderGoalProgress"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDaily"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/daily"
            android:textAllCaps="false"
            android:textColor="@color/green_text"
            app:backgroundTint="@color/white"
            app:cornerRadius="22dp"
            app:strokeColor="@color/sage_header"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWeekly"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/weekly"
            android:textAllCaps="false"
            android:textColor="@color/green_text"
            app:backgroundTint="@color/white"
            app:cornerRadius="22dp"
            app:strokeColor="@color/sage_header"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMonthly"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/monthly"
            android:textAllCaps="false"
            android:textColor="@color/green_text"
            app:backgroundTint="@color/period_selected"
            app:cornerRadius="22dp"
            app:strokeColor="@color/sage_header"
            app:strokeWidth="1dp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTransactions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/periodToggle"
        tools:listitem="@layout/item_transaction" />

    <TextView
        android:id="@+id/tvEmptyTransactions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/no_transactions"
        android:textColor="@color/hint_text"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvTransactions"
        app:layout_constraintEnd_toEndOf="@id/rvTransactions"
        app:layout_constraintStart_toStartOf="@id/rvTransactions"
        app:layout_constraintTop_toTopOf="@id/rvTransactions" />

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
