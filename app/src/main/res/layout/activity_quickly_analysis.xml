<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/quicklyAnalysisRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sage_header"
    tools:context=".QuicklyAnalysisActivity">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/green_text" />

    <TextView
        android:id="@+id/tvQuicklyTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/quickly_analysis"
        android:textColor="@color/green_text"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toStartOf="@id/btnHeaderBell"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <ImageButton
        android:id="@+id/btnHeaderBell"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_analysis_bell"
        android:contentDescription="@string/notifications"
        android:padding="8dp"
        android:src="@drawable/ic_bell"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:tint="@color/green_text" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quicklyHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <FrameLayout
            android:id="@+id/quicklyDonutWrap"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.example.mybudgettree.DonutTargetView
                android:id="@+id/quicklyGoalDonut"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="@string/watering_can_goal_savings"
                android:src="@drawable/ic_car"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvWateringCanLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="@string/watering_can_goal_savings"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="@id/quicklyDonutWrap"
            app:layout_constraintStart_toStartOf="@id/quicklyDonutWrap"
            app:layout_constraintTop_toBottomOf="@id/quicklyDonutWrap" />

        <View
            android:id="@+id/quicklyDivider"
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:background="@color/white"
            app:layout_constraintBottom_toBottomOf="@id/tvWateringCanLabel"
            app:layout_constraintStart_toEndOf="@id/quicklyDonutWrap"
            app:layout_constraintTop_toTopOf="@id/quicklyDonutWrap" />

        <ImageView
            android:id="@+id/ivRevenueIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="14dp"
            android:contentDescription="@string/revenue_last_week"
            android:src="@drawable/ic_money_stack"
            app:layout_constraintStart_toEndOf="@id/quicklyDivider"
            app:layout_constraintTop_toTopOf="@id/quicklyDonutWrap" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/revenue_last_week"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/ivRevenueIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivRevenueIcon"
            app:layout_constraintTop_toTopOf="@id/ivRevenueIcon" />

        <TextView
            android:id="@+id/tvRevenueLastWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ivRevenueIcon"
            app:layout_constraintTop_toBottomOf="@id/ivRevenueIcon"
            tools:text="R4,000.00" />

        <View
            android:id="@+id/weekMetricDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ivRevenueIcon"
            app:layout_constraintTop_toBottomOf="@id/tvRevenueLastWeek" />

        <ImageView
            android:id="@+id/ivFoodIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/food_last_week"
            android:src="@drawable/ic_utensils"
            app:layout_constraintStart_toStartOf="@id/ivRevenueIcon"
            app:layout_constraintTop_toBottomOf="@id/weekMetricDivider"
            app:tint="@color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/food_last_week"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@id/ivFoodIcon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivFoodIcon"
            app:layout_constraintTop_toTopOf="@id/ivFoodIcon" />

        <TextView
            android:id="@+id/tvFoodLastWeek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ivFoodIcon"
            app:layout_constraintTop_toBottomOf="@id/ivFoodIcon"
            tools:text="-R100.00" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/quicklySheet"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_notifications_sheet"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/quicklyHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chartCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_chart_card"
            android:padding="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvChartTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/green_text"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btnChartSearch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="April Expenses" />

            <ImageButton
                android:id="@+id/btnChartSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_chart_icon"
                android:contentDescription="@string/analysis_search"
                android:padding="7dp"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="@id/tvChartTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvChartTitle" />

            <com.example.mybudgettree.AnalysisChartView
                android:id="@+id/chartView"
                android:layout_width="0dp"
                android:layout_height="200dp"
                android:layout_marginTop="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvChartTitle" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQuickTransactions"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chartCard"
            tools:listitem="@layout/item_transaction" />

        <TextView
            android:id="@+id/tvEmptyQuick"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/no_transactions"
            android:textColor="@color/hint_text"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/rvQuickTransactions"
            app:layout_constraintStart_toStartOf="@id/rvQuickTransactions"
            app:layout_constraintTop_toTopOf="@id/rvQuickTransactions" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/include_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
