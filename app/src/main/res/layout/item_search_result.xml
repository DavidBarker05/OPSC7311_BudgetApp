<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_search_result"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/ivTransactionImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_result_icon"
        android:contentDescription="@string/transaction_image"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_utensils"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvTransactionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/green_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvTransactionAmount"
        app:layout_constraintStart_toEndOf="@id/ivTransactionImage"
        app:layout_constraintTop_toTopOf="@id/ivTransactionImage"
        tools:text="Dinner" />

    <TextView
        android:id="@+id/tvTransactionDetail"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/green_primary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tvTransactionName"
        app:layout_constraintStart_toStartOf="@id/tvTransactionName"
        app:layout_constraintTop_toBottomOf="@id/tvTransactionName"
        tools:text="18:27 - April 30" />

    <TextView
        android:id="@+id/tvTransactionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green_text"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/ivTransactionImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivTransactionImage"
        tools:text="-R26.00" />

</androidx.constraintlayout.widget.ConstraintLayout>
