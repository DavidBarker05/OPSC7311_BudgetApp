<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_search_result"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/ivContributionImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_result_icon"
        android:contentDescription="@string/amount_saved"
        android:padding="12dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_water_drop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvContributionDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/green_text"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/tvContributionAmount"
        app:layout_constraintStart_toEndOf="@id/ivContributionImage"
        app:layout_constraintTop_toTopOf="@id/ivContributionImage"
        tools:text="April 30, 2024" />

    <TextView
        android:id="@+id/tvContributionAmount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textColor="@color/green_text"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="@id/ivContributionImage"
        app:layout_constraintEnd_toStartOf="@id/btnRemoveContribution"
        app:layout_constraintTop_toTopOf="@id/ivContributionImage"
        tools:text="R150.00" />

    <ImageButton
        android:id="@+id/btnRemoveContribution"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/remove_savings"
        android:padding="6dp"
        android:src="@drawable/ic_delete"
        app:layout_constraintBottom_toBottomOf="@id/ivContributionImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivContributionImage"
        app:tint="@color/destructive_red" />

</androidx.constraintlayout.widget.ConstraintLayout>
