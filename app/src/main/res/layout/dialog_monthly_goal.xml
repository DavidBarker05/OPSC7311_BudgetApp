<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_card"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="28dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/set_monthly_goal"
        android:textColor="@color/green_text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/minimum_spend"
        android:textColor="@color/green_text"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etMonthlyGoalMin"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_sow_field"
        android:hint="@string/amount_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/green_text"
        android:textColorHint="@color/hint_text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/maximum_spend"
        android:textColor="@color/green_text"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etMonthlyGoalMax"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_sow_field"
        android:hint="@string/amount_hint"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:textColor="@color/green_text"
        android:textColorHint="@color/hint_text"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveMonthlyGoal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/save"
        android:textAllCaps="false"
        android:textColor="@color/green_text"
        android:textSize="16sp"
        app:backgroundTint="@color/sage_button"
        app:cornerRadius="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelMonthlyGoal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="@string/cancel"
        android:textAllCaps="false"
        android:textColor="@color/green_text"
        android:textSize="16sp"
        app:backgroundTint="@color/sow_field"
        app:cornerRadius="24dp" />
</LinearLayout>
