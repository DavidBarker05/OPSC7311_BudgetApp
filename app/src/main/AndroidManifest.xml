<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".BudgetTreeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyBudgetTree">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyBudgetTree.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".WelcomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Welcome" />
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SignupActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SecurityPinActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NewPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Auth"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PasswordChangedActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Success" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".QuicklyAnalysisActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".AnalysisActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".SearchActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".CategoriesActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".CategoryDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".SowExpensesActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SowIncomeActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditCategoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditSavingsGoalActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EditTransactionActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ViewImageActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".WateringCanActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".GoalDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".FillWateringCanActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".NotificationsActivity"
            android:exported="false"
            android:theme="@style/Theme.MyBudgetTree.Home" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
